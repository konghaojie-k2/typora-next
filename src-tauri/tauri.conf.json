{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TyporaNext",
  "version": "0.4.0",
  "identifier": "com.typora-next.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node tests/run-all.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Typora Next - Markdown Previewer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://ipc.localhost; img-src 'self' data: asset: https: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/md-file-256.png",
      "../agent-bridge.mjs",
      "../package.json",
      "skills/",
      "../samples/full.md"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NUU4NUMyMUMxRDZEQjkKUldTNWJSMGN3b1ZlSjZLcWlHaytETVBuekx2MWRkQWRHcytmRFloQW1SRjh6dFQvV2M5QkZyRDgK",
      "endpoints": [
        "https://github.com/konghaojie-k2/typora-next/releases/latest/download/latest.json"
      ]
    }
  }
}
